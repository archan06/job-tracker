# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Postgres connection used by the app. On Neon, use the pooled string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection, used by Prisma migrations. Optional if DATABASE_URL is already direct.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Separate database for integration and end-to-end tests. Its data is wiped on every test run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST-HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Needed when running a production build anywhere except Vercel (e.g. `npm start` locally). Vercel sets it automatically.
# AUTH_TRUST_HOST="true"

# Google sign-in (optional). Create OAuth credentials in Google Cloud Console.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Company search (server only) and logo images (publishable). Free plan at logo.dev.
LOGO_DEV_SECRET_KEY=""
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=""
# City suggestions (server only). Free plan at geoapify.com.
GEOAPIFY_API_KEY=""
# SUGGEST_PROVIDER="fake"  # end-to-end tests only

# Forwarded job emails (optional). Receive with Resend; read with Claude Haiku 4.5.
# INBOUND_EMAIL_DOMAIN: your Resend receiving domain, e.g. in.example.com (MX record) or <id>.resend.app.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
INBOUND_EMAIL_DOMAIN=""
ANTHROPIC_API_KEY=""
# INBOUND_PROVIDER="fake" / EMAIL_CLASSIFIER="fake"  # end-to-end tests only

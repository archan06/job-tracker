generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ApplicationSource {
  REFERRAL
  LINKEDIN
  COMPANY_SITE
  COLD_APPLY
  OTHER
}

enum EventType {
  STATUS_CHANGE
  INTERVIEW
  EMAIL
  NOTE
  FOLLOW_UP
}

model User {
  id            String    @id @default(cuid())
  /// Always stored lowercase.
  email         String    @unique
  name          String?
  /// Required by the Auth.js adapter.
  emailVerified DateTime?
  image         String?
  /// Null for users who only sign in with Google.
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  applications  Application[]
  oauthCodes    OAuthCode[]
  oauthGrants   OAuthGrant[]
  /// The secret part of the private forwarding address (u-<token>@<domain>). Null until first used.
  inboundToken  String?        @unique
  inboundEmails InboundEmail[]
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  company       String
  /// Bare website domain (e.g. "stripe.com"); keys the company logo.
  companyDomain String?
  title         String
  url           String?
  location      String?
  salaryRange   String?
  /// Cached current status. The Event rows are the source of truth.
  status        ApplicationStatus @default(SAVED)
  source        ApplicationSource @default(OTHER)
  dateApplied   DateTime?         @db.Date
  description   String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        Event[]
  reminders     Reminder[]
  inboundEmails InboundEmail[]

  @@index([userId, status])
}

model Event {
  id            String             @id @default(cuid())
  applicationId String
  type          EventType
  /// Null on the event that records an application's creation.
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus?
  /// A calendar day (UTC midnight) for every event type, so the timeline never shifts across time zones.
  date          DateTime           @default(now())
  notes         String?
  /// Orders events that share a day.
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, date])
}

model Reminder {
  id            String   @id @default(cuid())
  applicationId String
  dueAt         DateTime
  sent          Boolean  @default(false)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([dueAt, sent])
}

// Auth.js adapter models (https://authjs.dev/getting-started/adapters/prisma)

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Fixed-window counters for rate limiting (sign-in attempts, sign-ups, writes).
/// Kept in Postgres so limits hold across serverless instances.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

enum OAuthClientKind {
  /// Registered itself through POST /oauth/register.
  DCR
  /// Identified by a URL serving its metadata (Client ID Metadata Document).
  CIMD
}

/// An app that can ask users to connect it (Claude, ChatGPT, ...).
model OAuthClient {
  /// The client_id: random for DCR, the metadata URL for CIMD.
  id           String          @id
  name         String
  redirectUris String[]
  kind         OAuthClientKind
  createdAt    DateTime        @default(now())
  /// When CIMD metadata was last fetched.
  refreshedAt  DateTime        @default(now())

  codes  OAuthCode[]
  grants OAuthGrant[]
}

/// A one-time authorization code, valid for 60 seconds.
model OAuthCode {
  codeHash      String    @id
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One connection (one install) between a user and an app. Tokens are stored only as SHA-256 hashes.
model OAuthGrant {
  id                   String    @id @default(cuid())
  userId               String
  clientId             String
  scopes               String[]
  resource             String
  accessTokenHash      String?   @unique
  accessExpiresAt      DateTime?
  refreshTokenHash     String?   @unique
  refreshExpiresAt     DateTime?
  /// Refresh tokens already rotated out. Presenting one means it leaked, so the grant is revoked.
  retiredRefreshHashes String[]
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?
  revokedAt            DateTime?

  /// The authorization code that created this connection; a replayed code revokes only this one.
  codeHash  String?   @unique
  /// When the refresh token was last rotated; a retry within a minute isn't treated as theft.
  rotatedAt DateTime?

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientId])
}

enum InboundEmailKind {
  APPLICATION_CONFIRMATION
  INTERVIEW
  REJECTION
  OFFER
  NOT_JOB_RELATED
  GMAIL_FORWARDING_CONFIRMATION
}

enum InboundEmailState {
  /// The board was changed; can be undone.
  UPDATED
  NEEDS_REVIEW
  IGNORED
  /// Couldn't be read (AI error, limits); can be retried.
  FAILED
  UNDONE
}

/// A forwarded email and what Landed did with it. The full body is never stored; rows are deleted after 90 days.
model InboundEmail {
  id             String   @id @default(cuid())
  userId         String
  /// Resend's email_id, used to re-fetch content on retry.
  providerId     String
  messageId      String
  fromAddress    String
  subject        String
  receivedAt     DateTime
  snippet        String
  forwardingCode String?

  kind          InboundEmailKind?
  confidence    Float?
  company       String?
  jobTitle      String?
  companyDomain String?
  interviewAt   DateTime?
  summary       String?

  state                InboundEmailState
  reviewReason         String?
  applicationId        String?
  createdApplication   Boolean            @default(false)
  previousStatus       ApplicationStatus?
  previousDateApplied  DateTime?          @db.Date
  appliedStatus        ApplicationStatus?
  eventIds             String[]
  /// The application's updatedAt right after this email changed it; undo is refused if it has moved since.
  applicationUpdatedAt DateTime?
  /// The application's updatedAt before this email changed it; undo restores it so earlier emails stay undoable.
  previousUpdatedAt    DateTime?
  createdAt            DateTime           @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([userId, messageId])
  @@index([userId, state, createdAt])
}
